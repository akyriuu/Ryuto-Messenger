{
  "manifest_version": 3,
  "name": "Ryuto Messenger",
  "description": "Converse com seus amigos sem sair da aba atual.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": [
    "https://ryuto-messenger.onrender.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "sidebar_action": {
    "default_title": "Ryuto Messenger",
    "default_panel": "index.html",
    "default_icon": "icons/icon48.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "ryuto-messenger@akyriu",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "personalCommunications",
          "personallyIdentifyingInfo"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
