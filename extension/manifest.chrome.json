{
  "manifest_version": 3,
  "name": "Ryuto Messenger",
  "description": "Converse com seus amigos sem sair da aba atual.",
  "version": "0.1.0",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": [
    "https://ryuto-messenger.onrender.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*"
  ],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "index.html" },
  "action": { "default_title": "Abrir Ryuto Messenger" },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
